# Bind address. Empty (the default) binds all interfaces, which the container needs. Keep 127.0.0.1
# for local dev: anything on 0.0.0.0 on a machine with a public IP is reachable from the internet.
HOST=127.0.0.1
PORT=8000

# Postgres; `docker compose up -d` starts this one.
DATABASE_URL=postgres://growth:growth@127.0.0.1:5435/growth?sslmode=disable

# luma-service, run locally from ../luma-service (it listens on 8001 with its example env).
# Deployed: http://<luma-service app name>:8000 on dokploy-network.
LUMA_SERVICE_URL=http://127.0.0.1:8001
# Must equal luma-service's LUMA_SERVICE_SECRET.
LUMA_SERVICE_SECRET=<LUMA_SERVICE_SECRET>

# Sign-in stand-in until identity-service is live (docs/pcr/0006): every request is signed in as this
# user. Unset, the API refuses every request but health. Never set in production.
DEV_USER_EMAIL=dev@kthais.com
